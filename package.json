{
  "name": "lump",
  "private": true,
  "version": "1.0.0",
  "description": "Markdown-to-PDF workflow: Slidev slide decks, presenter-notes handouts, and plain Markdown documents",
  "type": "module",
  "bin": {
    "lump": "bin/lump.js"
  },
  "scripts": {
    "lump": "tsx scripts/lump.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.slidev.json"
  },
  "dependencies": {
    "@shikijs/markdown-it": "^3.23.0",
    "@slidev/cli": "^51.5.1",
    "katex": "^0.16.47",
    "liquidjs": "^10.30.0",
    "manim-web": "^0.39.1",
    "markdown-it": "^14.3.0",
    "mermaid": "^11.17.2",
    "playwright-chromium": "^1.62.1",
    "shiki": "^3.23.0",
    "slidev-theme-academic": "^3.0.1",
    "tsx": "^4.23.15",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
