{
  // Type-checking only (`npm run typecheck`) for the code that runs in the browser: lump's addon (`slidev/`) and the
  // example deck's Manim scene (`examples/slides/manim/`). Vite bundles these, so imports need no extensions; `lump-manim/*`
  // is the alias set in slidev/vite.config.ts.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "paths": { "lump-manim/*": ["./slidev/manim/*"] }
  },
  "include": ["slidev/**/*.ts", "examples/slides/manim/**/*.ts"]
}
