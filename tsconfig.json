{
  // Type-checking only (`npm run typecheck`); the scripts are run directly
  // from their .ts sources by tsx, so nothing is ever compiled to .js.
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts"]
}
